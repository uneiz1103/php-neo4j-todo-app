{
    "name": "uneiz/todo-app",
    "description": "PHP + Neo4j Todo application for learning CRUD and OOP",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Uneiz\\TodoApp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Uneiz Shaikh"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "laudis/neo4j-php-client": "^3.6",
